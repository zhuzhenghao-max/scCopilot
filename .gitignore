# 密钥与环境
.env
*.env.local

# 数据：原始/中间产物不入库（体积大且可再生）
data/raw/*.h5ad
data/raw/*.h5
data/raw/*.csv
data/uploads/*
data/processed/
data/cache/
# 人工复核日志：用户对自家数据的判型决定，属于本机工作产物，不入库
data/reviews/
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep
!data/uploads/.gitkeep

# numba 编译缓存（scanpy 首次调用会写，体积可能几十 MB）
.numbacache/

# 调研草稿与逐帧截图（43MB 过程产物，不是交付物）
_research/
_tmp_*.json

# Qoder Sites 本地描述符：内部 projectId/siteId/deploymentId + 发布快照，属于机器状态
*.qoder.site

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Streamlit / IDE
.streamlit/secrets.toml
.ipynb_checkpoints/
.vscode/
.idea/
