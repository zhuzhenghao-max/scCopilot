# scCopilot LLM 配置（复制为 .env 后填写；.env 已被 .gitignore 忽略）
# 任何 OpenAI 兼容网关都能用：OpenAI / DeepSeek / 通义千问 / Moonshot / 本地 Ollama+vLLM

# 必填：API Key。代码里只用 os.getenv("LLM_API_KEY") 读取，绝不硬编码。
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 兼容网关地址。留空则使用 https://api.openai.com/v1
#   DeepSeek     -> https://api.deepseek.com/v1
#   通义千问     -> https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 Ollama  -> http://localhost:11434/v1
LLM_BASE_URL=

# 模型名。留空则用 qwen-plus（中文输出稳、便宜、够用）
#   OpenAI: gpt-4o-mini    DeepSeek: deepseek-chat    Ollama: qwen2.5:14b
LLM_MODEL=

# 单次解读的温度。防幻觉场景保持低温（0.1~0.3），不要调高
LLM_TEMPERATURE=0.2

# 超时与重试（秒 / 次）
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# 响应缓存：同一份 prompt + 同一模型只敲一次网关，第二次直接复现同一句话（默认开）
# 落盘在 data/cache/llm/（已被 .gitignore 忽略，文件里只有回复正文/模型/时间，绝不含 Key）
LLM_CACHE=1
# LLM_CACHE_DIR=

# 可选：关掉 AI 面板（评委演示无网络时用）
SCCOPILOT_DISABLE_AI=0
